<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aidocchat-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.0.0" />
    <PackageReference Include="UploadGuard" Version="0.1.0-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiDocChat.Tests" />
  </ItemGroup>

</Project>
